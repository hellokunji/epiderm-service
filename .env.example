# Application
PROJECT_NAME=Epiderm Clinic Service
API_V1_STR=/api/v1

# Auth
S2S_API_KEY=change-me-internal-api-key
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+psycopg2://epiderm:epiderm@localhost:5432/clinic
MONGODB_URL=mongodb://epiderm:epiderm@localhost:27017/?authSource=admin
MONGODB_DB_NAME=clinic

# Redis / Celery (use localhost when running API/consumer on the host)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_RESULT_EXPIRES=86400
CELERY_DIAGNOSIS_WORKER_CONCURRENCY=1


# Ollama (host machine when running Docker locally on macOS/Windows)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=gemma3:12b

# RAG (diagnosis worker only; uses BAAI/bge-small-en-v1.5 — same model as ingest)
RAG_ENABLED=true
RAG_TOP_K=3
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
