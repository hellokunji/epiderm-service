# Application
PROJECT_NAME=Epiderm Clinic Service
API_V1_STR=/api/v1

# Auth
S2S_API_KEY=change-me-in-production
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Database (reserved for future use)
DATABASE_URL=sqlite:///./test.db

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_RESULT_EXPIRES=86400
CELERY_DIAGNOSIS_WORKER_CONCURRENCY=1

# Ollama (host machine when running Docker locally on macOS/Windows)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=gemma3:12b
